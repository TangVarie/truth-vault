{
  "$schema": "https://railway.app/railway.schema.json",
  "//": "写作台内核 deskcore/ 的 Railway 部署配置 (D-041)。root = repo 根, 让 `deskcore` 包可导入 —— 与 librarian/onboarder/worker 同一套模板。",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "pip install -r deskcore/requirements.txt"
  },
  "deploy": {
    "startCommand": "uvicorn deskcore.app:app --host 0.0.0.0 --port $PORT",
    "healthcheckPath": "/health",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3
  }
}
