# ════════════════════════════════════════════════════════════════════
# Truth Vault sync scripts · environment variables
# ════════════════════════════════════════════════════════════════════
#
# 1. cp .env.example .env
# 2. 把下面的占位符换成实际值
# 3. 不要 commit .env 到 git（已在 .gitignore 里）
# 4. 在生产环境用 GitHub Secrets / 系统 env vars / vault 注入，不要明文存
#
# ════════════════════════════════════════════════════════════════════

# ── Supabase（共享实例）────────────────────────────────────────────────
# 从 Supabase Dashboard → Settings → API 拿
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# ⚠ service_role secret，不是 anon。看 Settings → API → service_role
# 这个 key 绕过 RLS，绝不能进前端 / 客户端。
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.XXXXXXXX...

# ── 飞书 (仅 sync_feishu_notes_to_truth_vault.py 需要) ───────────────
# 飞书开放平台 → 你的应用 → 凭证与基础信息
FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxx
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# (可选) 如果 mapping yaml 没在 sync_config 里指定 feishu_app_token / table_id，
# 可以用 env vars 覆盖。但建议直接写在 yaml 里。
# FEISHU_APP_TOKEN=bascn........
# FEISHU_TABLE_ID=tbl........

# ── autowriter sync 用户 (仅 sync_truth_vault_baokuan_to_autowriter_items.py 需要) ──
# 2026-05-21 audit 后改为可选: sync 脚本默认从 autowriter.projects.owner_id
# 解析 user_id (RLS 兼容). 这个 env 仅在 owner_id 缺失时作为兜底.
# 正常部署可以不配。
AUTOWRITER_SYNC_USER_ID=00000000-0000-0000-0000-000000000000

# ── autowriter sync 注入配额 (2026-05-22 audit P1-2) ──────────────────
# 每个 autowriter 项目每轮 sync 最多注入多少条 baokuan (默认 5).
# 老版本用 AUTOWRITER_INJECTION_MAX_PER_RUN 做全局上限, 大项目会独占名额、
# 小项目饥饿. 新版改成 per-project 配额防饥饿. 旧 env 仍读作 fallback alias.
AUTOWRITER_INJECTION_MAX_PER_PROJECT=5

# 可选: round-robin 全局上限. 配了之后 sync 先按 per-project 配额算出候选,
# 再按项目轮询取 GLOBAL_CAP 条. 不配 = 不设全局上限 (每个项目独立跑 per-project).
# AUTOWRITER_INJECTION_GLOBAL_CAP=20

# ── Anthropic (仅 annotate_essence_pass.py 需要) ────────────────────
# 从 https://console.anthropic.com/settings/keys 拿
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 中转站地址 (可选). 不设 = 走官方 endpoint; 夜跑 / Railway 上是中转站地址 (D-100).
# ⚠️ 不用就整行注释掉, 别留成 `ANTHROPIC_BASE_URL=` 空串: SDK 会把空串当成显式地址, 请求直接报错.
# ANTHROPIC_BASE_URL=https://<中转站地址>

# ── 备用中转站 (可选, D-148) ─────────────────────────────────────────
# 两个都填了才启用; 缺一个 = 没配, 行为和现在完全一样.
# 配了以后: 每次调用先打主站 (只给一次机会、限时), 主站超时 / 连不上 / 429 / 5xx / 401-404 → 这次改打备用站;
# 主站连续 2 次失败或慢 → 熔断 20 分钟直接走备用站. 400 类请求错误、中转站敏感词拦截 (D-125) 不切.
# 备用站必须认同样的模型名 (claude-sonnet-5-5 / claude-haiku-5-5). 运行手册: docs/12-daily-sync-troubleshooting.md
ANTHROPIC_BASE_URL_BACKUP=
ANTHROPIC_API_KEY_BACKUP=
# 手动切换: backup = 只走备用站; primary = 只走主站 (等于没配备用站); 空 = 自动.
RELAY_FORCE=
# 可调 (一般不用动): 主站单次限时秒数 / 慢的门槛秒数 (0 = 不按慢判) / 连续几次失败熔断 / 熔断多久 (秒)
# RELAY_PRIMARY_TIMEOUT_S=60
# RELAY_SLOW_S=25
# RELAY_BREAKER_FAILS=2
# RELAY_BREAKER_COOLDOWN_S=1200

# 模型 ID. 默认 claude-sonnet-5-5. 上线前查
# https://docs.anthropic.com/en/docs/about-claude/models 核实最新 ID.
ESSENCE_MODEL=claude-sonnet-5-5

# ── 日志级别 (可选) ──────────────────────────────────────────────────
LOG_LEVEL=INFO
